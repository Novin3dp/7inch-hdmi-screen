  (text "AT070TN92 7\" 800x480 TTL panel driver for the Raspberry Pi DSI port: ICN6211 DSI->RGB888 bridge."
    (at 20 145 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "J1 = Pi 15-pin DSI (Pi 3/4; Pi 5 / CM via the standard 22->15 pin display cable). Pins 14/15 (3V3) unused."
    (at 20 151 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "J2 -> Pi 40-pin header: 5 V (pins 2/4), GND, DSI_EN, TP_INT, TP_RST, BL_PWM GPIOs (see rpi_dsi/)."
    (at 20 157 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "Touch (GT915) and ICN6211 I2C share the DSI-connector I2C bus (i2c_csi_dsi)."
    (at 20 163 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "DSI_EN high: panel RESET released after ~1 ms, bias (AVDD/VGL/VGH) after ~50 ms (RC)."
    (at 20 169 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "J3 pad numbers equal AT070TN92 FPC pin numbers; use a TOP-contact 0.5 mm 50-pin FPC connector."
    (at 20 175 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
