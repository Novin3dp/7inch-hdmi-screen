  (text "AT070TN92 7\" 800x480 TTL panel driver: HDMI (LT8619C) + GT915 touch -> USB HID (STM32F072)."
    (at 20 145 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "Power: USB-C 5 V (from Raspberry Pi USB port, ~0.7 A max with backlight at 100 %)."
    (at 20 151 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "Panel power-up order (MCU controlled): DVDD -> RESET -> VGL/AVDD -> VGH -> data -> backlight."
    (at 20 157 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "J3 pad numbers equal AT070TN92 FPC pin numbers; use a TOP-contact 0.5 mm 50-pin FPC connector."
    (at 20 163 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
  (text "VCOM (pins 6/46) is adjustable with RV1 (2.55..4.5 V): trim for minimum flicker."
    (at 20 169 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left)))
